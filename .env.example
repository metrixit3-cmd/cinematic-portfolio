# Copy this file to .env.local (gitignored) and fill in your own Formspree form ID.
# Get one free at https://formspree.io (no card needed) -> create a form -> copy the ID from the endpoint URL
# (https://formspree.io/f/XXXXXXXX -> the XXXXXXXX part).
# For the live site, set the same variable in Vercel: Project Settings -> Environment Variables.
VITE_FORMSPREE_ID=
